<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>RPG Character Creation Portal</title>
  <style>
    /* CSS RESET & VARIABLES */
    :root {
      --bg-dark: #0f0e13;
      --bg-card: #1a1824;
      --bg-panel: #232030;
      --bg-input: #12101a;
      --gold-main: #d4af37;
      --gold-hover: #f3c846;
      --gold-dim: #8c7323;
      --text-main: #f0ecf4;
      --text-muted: #a09abc;
      --border-card: #3a354c;
      --danger: #9e2a2b;
      --success: #2a9d8f;
      --font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
    }

    * {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    body {
      background-color: var(--bg-dark);
      color: var(--text-main);
      font-family: var(--font-family);
      line-height: 1.4;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
    }

    /* SCROLLBAR */
    ::-webkit-scrollbar {
      width: 8px;
    }
    ::-webkit-scrollbar-track {
      background: var(--bg-dark);
    }
    ::-webkit-scrollbar-thumb {
      background: var(--border-card);
      border-radius: 4px;
    }
    ::-webkit-scrollbar-thumb:hover {
      background: var(--gold-main);
    }

    /* HEADER */
    header {
      background-color: var(--bg-panel);
      border-bottom: 2px solid var(--gold-main);
      padding: 1rem 1.5rem;
      box-shadow: 0 4px 15px rgba(0,0,0,0.5);
    }

    .header-content {
      max-width: 1250px;
      margin: 0 auto;
      display: flex;
      justify-content: space-between;
      align-items: center;
      flex-wrap: wrap;
      gap: 1rem;
    }

    .app-title {
      color: var(--gold-main);
      font-size: 1.5rem;
      font-weight: 700;
      letter-spacing: 1px;
      text-transform: uppercase;
      display: flex;
      align-items: center;
      gap: 0.5rem;
    }

    .header-buttons {
      display: flex;
      gap: 0.75rem;
    }

    /* BUTTONS */
    .btn {
      background-color: var(--bg-card);
      color: var(--gold-main);
      border: 1px solid var(--gold-main);
      padding: 0.5rem 1rem;
      border-radius: 6px;
      font-weight: 600;
      font-size: 0.875rem;
      cursor: pointer;
      transition: all 0.2s ease;
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      text-decoration: none;
    }

    .btn:hover {
      background-color: var(--gold-main);
      color: #000;
      box-shadow: 0 0 10px rgba(212, 175, 55, 0.4);
    }

    .btn-primary {
      background-color: var(--gold-main);
      color: #000;
    }

    .btn-primary:hover {
      background-color: var(--gold-hover);
      box-shadow: 0 0 15px rgba(243, 200, 70, 0.6);
    }

    .btn-danger {
      background-color: rgba(158, 42, 43, 0.2);
      color: #ff8888;
      border-color: var(--danger);
    }

    .btn-danger:hover {
      background-color: var(--danger);
      color: #fff;
    }

    .btn:disabled {
      opacity: 0.4;
      cursor: not-allowed;
      border-color: var(--border-card);
      color: var(--text-muted);
      background-color: var(--bg-card);
      box-shadow: none;
    }

    /* MAIN CONTAINER */
    main {
      max-width: 1250px;
      margin: 0 auto;
      padding: 1.5rem;
      width: 100%;
      flex-grow: 1;
      display: flex;
      flex-direction: column;
    }

    /* WIZARD STEP INDICATOR */
    .wizard-steps {
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 2rem;
      position: relative;
      max-width: 900px;
      margin-left: auto;
      margin-right: auto;
      width: 100%;
    }

    .wizard-steps::before {
      content: '';
      position: absolute;
      top: 20px;
      left: 0;
      right: 0;
      height: 2px;
      background-color: var(--border-card);
      z-index: 1;
    }

    .progress-line-active {
      position: absolute;
      top: 20px;
      left: 0;
      height: 2px;
      background-color: var(--gold-main);
      z-index: 2;
      transition: width 0.3s ease;
    }

    .step-item {
      position: relative;
      z-index: 3;
      display: flex;
      flex-direction: column;
      align-items: center;
      background: none;
      border: none;
      cursor: pointer;
    }

    .step-number {
      width: 40px;
      height: 40px;
      border-radius: 50%;
      background-color: var(--bg-card);
      border: 2px solid var(--border-card);
      color: var(--text-muted);
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 700;
      transition: all 0.3s ease;
    }

    .step-label {
      font-size: 0.75rem;
      color: var(--text-muted);
      margin-top: 0.5rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .step-item.active .step-number {
      background-color: var(--gold-main);
      border-color: var(--gold-main);
      color: #000;
      box-shadow: 0 0 15px rgba(212, 175, 55, 0.5);
    }

    .step-item.active .step-label {
      color: var(--gold-main);
    }

    .step-item.completed .step-number {
      background-color: var(--bg-panel);
      border-color: var(--gold-main);
      color: var(--gold-main);
    }

    /* TOOLBAR */
    .toolbar {
      background-color: var(--bg-panel);
      padding: 1rem;
      border-radius: 8px;
      border: 1px solid var(--border-card);
      margin-bottom: 1.5rem;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .search-input {
      width: 100%;
      padding: 0.75rem 1rem;
      background-color: var(--bg-input);
      border: 1px solid var(--border-card);
      border-radius: 6px;
      color: #fff;
      font-size: 0.95rem;
      outline: none;
      transition: border-color 0.2s;
    }

    .search-input:focus {
      border-color: var(--gold-main);
    }

    .filter-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 0.5rem;
      justify-content: center;
    }

    .tag-btn {
      background-color: var(--bg-card);
      color: var(--text-muted);
      border: 1px solid var(--border-card);
      padding: 0.35rem 0.75rem;
      border-radius: 20px;
      font-size: 0.75rem;
      cursor: pointer;
      transition: all 0.2s ease;
    }

    .tag-btn:hover {
      border-color: var(--gold-main);
      color: var(--text-main);
    }

    .tag-btn.active {
      background-color: var(--gold-main);
      color: #000;
      border-color: var(--gold-main);
      font-weight: 700;
    }

    /* CARDS GRID */
    .cards-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
      gap: 1.25rem;
      margin-bottom: 2rem;
    }

    .rpg-card {
      background-color: var(--bg-card);
      border: 2px solid var(--border-card);
      border-radius: 10px;
      overflow: hidden;
      cursor: pointer;
      transition: all 0.25s ease;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
      position: relative;
    }

    .rpg-card:hover {
      transform: translateY(-4px);
      border-color: var(--gold-main);
      box-shadow: 0 8px 20px rgba(0,0,0,0.6), 0 0 10px rgba(212, 175, 55, 0.2);
    }

    .rpg-card.selected {
      border-color: var(--gold-main);
      background-color: #252136;
      box-shadow: 0 0 20px rgba(212, 175, 55, 0.4);
    }

    .card-img-wrapper {
      position: relative;
      height: 260px;
      width: 100%;
      background-color: #0a0a0f;
      overflow: hidden;
      border-bottom: 1px solid var(--border-card);
      display: flex;
      align-items: center;
      justify-content: center;
    }

    .card-img {
      width: 100%;
      height: 100%;
      object-fit: contain;
      object-position: center top;
      transition: transform 0.4s ease;
    }

    .rpg-card:hover .card-img {
      transform: scale(1.03);
    }

    .badge-tag {
      position: absolute;
      bottom: 8px;
      left: 8px;
      background-color: rgba(15, 14, 19, 0.85);
      color: var(--gold-main);
      border: 1px solid var(--gold-dim);
      padding: 0.15rem 0.5rem;
      border-radius: 4px;
      font-size: 0.65rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: 700;
    }

    .selected-check {
      position: absolute;
      top: 8px;
      right: 8px;
      width: 26px;
      height: 26px;
      background-color: var(--gold-main);
      color: #000;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: bold;
      font-size: 0.85rem;
      box-shadow: 0 2px 5px rgba(0,0,0,0.5);
    }

    .card-body {
      padding: 1rem;
      display: flex;
      flex-direction: column;
      flex-grow: 1;
      gap: 0.5rem;
    }

    .card-title {
      font-size: 1.15rem;
      color: var(--gold-main);
      font-weight: 700;
    }

    .card-subtitle {
      font-size: 0.75rem;
      color: #e2cc9d;
      font-family: monospace;
      font-weight: 600;
    }

    .card-desc {
      font-size: 0.8rem;
      color: var(--text-muted);
      line-height: 1.4;
      display: -webkit-box;
      -webkit-line-clamp: 3;
      -webkit-box-orient: vertical;
      overflow: hidden;
    }

    .card-footer {
      padding: 0.75rem 1rem;
      border-top: 1px solid rgba(255,255,255,0.05);
    }

    .card-select-btn {
      width: 100%;
      padding: 0.4rem;
      font-size: 0.8rem;
      border-radius: 4px;
      background: var(--bg-panel);
      border: 1px solid var(--border-card);
      color: var(--gold-main);
      font-weight: 600;
      cursor: pointer;
    }

    .rpg-card.selected .card-select-btn {
      background-color: var(--gold-main);
      color: #000;
    }

    /* STEP 4: FORM PANEL */
    .form-panel {
      background-color: var(--bg-card);
      border: 2px solid var(--border-card);
      border-radius: 12px;
      padding: 1.5rem;
      max-width: 950px;
      margin: 0 auto;
      width: 100%;
    }

    .form-section-title {
      color: var(--gold-main);
      font-size: 1.1rem;
      margin-bottom: 0.75rem;
      border-bottom: 1px solid var(--border-card);
      padding-bottom: 0.4rem;
      text-transform: uppercase;
      letter-spacing: 0.5px;
    }

    .stats-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(130px, 1fr));
      gap: 0.75rem;
      margin-bottom: 1.5rem;
    }

    .stat-box {
      background-color: var(--bg-panel);
      border: 1px solid var(--border-card);
      border-radius: 8px;
      padding: 0.75rem;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 0.35rem;
    }

    .stat-box label {
      font-size: 0.8rem;
      color: var(--gold-main);
      font-weight: 700;
    }

    .stat-box input[type="number"] {
      width: 55px;
      padding: 0.3rem;
      background-color: var(--bg-dark);
      border: 1px solid var(--border-card);
      border-radius: 4px;
      color: #fff;
      text-align: center;
      font-size: 1.1rem;
      font-weight: bold;
      outline: none;
    }

    .mod-checkbox-label {
      font-size: 0.7rem;
      color: var(--text-muted);
      display: flex;
      align-items: center;
      gap: 0.25rem;
      cursor: pointer;
    }

    .selection-toggle-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(180px, 1fr));
      gap: 0.5rem;
      margin-bottom: 1.5rem;
      background-color: var(--bg-panel);
      padding: 0.75rem;
      border-radius: 8px;
      border: 1px solid var(--border-card);
    }

    .toggle-item {
      display: flex;
      align-items: center;
      gap: 0.5rem;
      font-size: 0.8rem;
      color: var(--text-main);
      cursor: pointer;
    }

    .toggle-item input[type="checkbox"] {
      accent-color: var(--gold-main);
    }

    /* NAVIGATION BAR */
    .nav-bar {
      margin-top: auto;
      padding-top: 1rem;
      border-top: 1px solid var(--border-card);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .nav-status {
      font-size: 0.85rem;
      color: var(--text-muted);
    }

    /* ==========================================================================
       STEP 5: REAL D&D CHARACTER SHEET LAYOUT
       ========================================================================== */
    .sheet-wrapper {
      max-width: 1100px;
      margin: 0 auto;
      width: 100%;
    }

    .cs-sheet {
      background-color: #161420;
      border: 2px solid var(--gold-main);
      border-radius: 12px;
      padding: 1.25rem;
      box-shadow: 0 10px 30px rgba(0,0,0,0.8);
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    /* CS HEADER FRAME */
    .cs-header {
      display: grid;
      grid-template-columns: 2fr 3fr;
      gap: 1rem;
      background-color: var(--bg-panel);
      border: 1px solid var(--gold-dim);
      border-radius: 8px;
      padding: 0.75rem 1rem;
      align-items: center;
    }

    .cs-name-box h1 {
      font-size: 1.6rem;
      color: #fff;
      line-height: 1.1;
    }

    .cs-name-box label {
      font-size: 0.65rem;
      color: var(--gold-main);
      text-transform: uppercase;
      letter-spacing: 0.5px;
      font-weight: bold;
    }

    .cs-header-fields {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.5rem 0.75rem;
    }

    .cs-field {
      border-bottom: 1px solid var(--border-card);
      padding-bottom: 0.15rem;
    }

    .cs-field .val {
      font-size: 0.85rem;
      color: #fff;
      font-weight: 600;
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .cs-field label {
      font-size: 0.55rem;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: bold;
      display: block;
    }

    /* CS MAIN LAYOUT GRID (3 COLUMNS) */
    .cs-main-grid {
      display: grid;
      grid-template-columns: 220px 280px 1fr;
      gap: 1rem;
    }

    /* COLUMN 1: ABILITIES, SAVES, PASSIVES */
    .cs-col-1 {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .cs-ability-stack {
      display: flex;
      flex-direction: column;
      gap: 0.4rem;
    }

    .cs-ability-card {
      background-color: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 6px;
      padding: 0.35rem;
      display: flex;
      align-items: center;
      justify-content: space-between;
      position: relative;
    }

    .cs-ability-card.modified {
      border-color: var(--gold-main);
    }

    .cs-ability-label {
      font-size: 0.7rem;
      color: var(--gold-main);
      font-weight: 800;
      width: 35px;
    }

    .cs-ability-mod {
      font-size: 1.1rem;
      font-weight: 800;
      color: #fff;
      background-color: var(--bg-panel);
      padding: 0.1rem 0.5rem;
      border-radius: 4px;
      border: 1px solid var(--gold-dim);
      min-width: 42px;
      text-align: center;
    }

    .cs-ability-score {
      font-size: 0.75rem;
      color: var(--text-muted);
      font-weight: 600;
      width: 30px;
      text-align: right;
    }

    .cs-box {
      background-color: var(--bg-panel);
      border: 1px solid var(--border-card);
      border-radius: 6px;
      padding: 0.6rem;
    }

    .cs-box-title {
      font-size: 0.65rem;
      color: var(--gold-main);
      font-weight: 800;
      text-transform: uppercase;
      border-bottom: 1px solid var(--border-card);
      padding-bottom: 0.25rem;
      margin-bottom: 0.4rem;
      letter-spacing: 0.5px;
    }

    .cs-list {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .cs-list-item {
      display: flex;
      align-items: center;
      font-size: 0.7rem;
      gap: 0.35rem;
    }

    .cs-dot {
      width: 7px;
      height: 7px;
      border-radius: 50%;
      border: 1px solid var(--gold-main);
      background-color: transparent;
      display: inline-block;
    }

    .cs-dot.active {
      background-color: var(--gold-main);
    }

    .cs-list-val {
      font-weight: 700;
      color: #fff;
      min-width: 22px;
    }

    .cs-list-lbl {
      color: var(--text-muted);
      white-space: nowrap;
      overflow: hidden;
      text-overflow: ellipsis;
    }

    .cs-passive-item {
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.7rem;
      padding: 0.15rem 0;
      border-bottom: 1px dashed rgba(255,255,255,0.05);
    }

    .cs-passive-item .val {
      font-weight: bold;
      color: var(--gold-hover);
    }

    /* COLUMN 2: COMBAT & SKILLS */
    .cs-col-2 {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .cs-combat-grid {
      display: grid;
      grid-template-columns: repeat(3, 1fr);
      gap: 0.4rem;
    }

    .cs-combat-tile {
      background-color: var(--bg-card);
      border: 1px solid var(--gold-dim);
      border-radius: 6px;
      padding: 0.4rem;
      text-align: center;
      display: flex;
      flex-direction: column;
      align-items: center;
      justify-content: center;
    }

    .cs-combat-tile .val {
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--gold-main);
      line-height: 1.1;
    }

    .cs-combat-tile .lbl {
      font-size: 0.55rem;
      color: var(--text-muted);
      text-transform: uppercase;
      font-weight: bold;
      margin-top: 0.15rem;
    }

    .cs-hp-box {
      background-color: var(--bg-card);
      border: 1px solid var(--border-card);
      border-radius: 6px;
      padding: 0.5rem;
      display: flex;
      justify-content: space-around;
      align-items: center;
      text-align: center;
    }

    .cs-hp-sub {
      display: flex;
      flex-direction: column;
    }

    .cs-hp-sub .val {
      font-size: 1rem;
      font-weight: 800;
      color: #fff;
    }

    .cs-hp-sub .lbl {
      font-size: 0.55rem;
      color: var(--text-muted);
      text-transform: uppercase;
    }

    /* COLUMN 3: FEATURE CARDS (SPECIES, CLASS, BG) */
    .cs-col-3 {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }

    .cs-feature-card {
      background-color: var(--bg-panel);
      border: 1px solid var(--border-card);
      border-radius: 8px;
      padding: 0.6rem;
      display: flex;
      gap: 0.75rem;
      align-items: flex-start;
    }

    .cs-feature-img {
      width: 75px;
      height: 90px;
      object-fit: contain;
      background-color: #0d0c12;
      border-radius: 4px;
      border: 1px solid var(--gold-dim);
      flex-shrink: 0;
    }

    .cs-feature-content {
      display: flex;
      flex-direction: column;
      gap: 0.2rem;
    }

    .cs-feature-title {
      font-size: 0.9rem;
      color: var(--gold-main);
      font-weight: bold;
    }

    .cs-feature-sub {
      font-size: 0.7rem;
      color: #e2cc9d;
      font-family: monospace;
      font-weight: bold;
    }

    .cs-feature-desc {
      font-size: 0.72rem;
      color: var(--text-muted);
      line-height: 1.3;
    }

    /* MODAL FOR EDITING */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0,0,0,0.85);
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 1rem;
      z-index: 100;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.25s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }

    .modal-box {
      background-color: var(--bg-card);
      border: 2px solid var(--gold-main);
      border-radius: 12px;
      width: 100%;
      max-width: 600px;
      max-height: 90vh;
      display: flex;
      flex-direction: column;
      overflow: hidden;
      box-shadow: 0 10px 30px rgba(0,0,0,0.9);
    }

    .modal-header {
      padding: 1rem;
      background-color: var(--bg-panel);
      border-bottom: 1px solid var(--border-card);
      display: flex;
      justify-content: space-between;
      align-items: center;
    }

    .modal-header h3 {
      color: var(--gold-main);
    }

    .modal-close {
      background: none;
      border: none;
      color: var(--text-muted);
      font-size: 1.5rem;
      cursor: pointer;
    }

    .modal-body {
      padding: 1.25rem;
      overflow-y: auto;
      display: flex;
      flex-direction: column;
      gap: 1rem;
    }

    .modal-footer {
      padding: 1rem;
      background-color: var(--bg-panel);
      border-top: 1px solid var(--border-card);
      display: flex;
      justify-content: flex-end;
      gap: 0.75rem;
    }

    .form-group {
      display: flex;
      flex-direction: column;
      gap: 0.35rem;
    }

    .form-group label {
      font-size: 0.8rem;
      color: var(--gold-main);
      font-weight: 600;
    }

    .form-group input, .form-group textarea, .form-group select {
      padding: 0.6rem;
      background-color: var(--bg-dark);
      border: 1px solid var(--border-card);
      border-radius: 6px;
      color: #fff;
      font-size: 0.9rem;
      outline: none;
    }

    /* TOAST */
    .toast {
      position: fixed;
      bottom: 20px;
      right: 20px;
      background-color: var(--gold-main);
      color: #000;
      padding: 0.75rem 1.25rem;
      border-radius: 6px;
      font-weight: 700;
      box-shadow: 0 5px 15px rgba(0,0,0,0.5);
      transform: translateY(100px);
      opacity: 0;
      transition: all 0.3s ease;
      z-index: 200;
    }

    .toast.show {
      transform: translateY(0);
      opacity: 1;
    }

    .hidden {
      display: none !important;
    }

    /* PRINT STYLES */
    @media print {
      header, .wizard-steps, .toolbar, .nav-bar, .no-print, .header-buttons {
        display: none !important;
      }
      body {
        background-color: #fff !important;
        color: #000 !important;
      }
      .cs-sheet {
        border: 2px solid #000 !important;
        box-shadow: none !important;
        background: #fff !important;
        color: #000 !important;
      }
      .cs-header, .cs-box, .cs-feature-card, .cs-ability-card, .cs-combat-tile {
        background: #f8f8f8 !important;
        border: 1px solid #aaa !important;
      }
      .cs-name-box h1, .cs-field .val, .cs-feature-title, .cs-box-title, .cs-combat-tile .val, .cs-ability-mod, .cs-list-val {
        color: #000 !important;
      }
    }
  </style>
</head>
<body>

  <!-- HEADER -->
  <header>
    <div class="header-content">
      <div class="app-title">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
        </svg>
        <span>RPG Character Portal</span>
      </div>
      <div class="header-buttons">
        <button onclick="openEditorModal()" class="btn">⚙️ Teacher Content Mode</button>
        <button onclick="resetAllSelections()" class="btn btn-danger">↺ Reset</button>
      </div>
    </div>
  </header>

  <!-- MAIN CONTAINER -->
  <main>
    <!-- 5-STEP WIZARD INDICATOR -->
    <div class="wizard-steps no-print">
      <div class="progress-line-active" id="progress-line"></div>
      
      <button onclick="goToStep(1)" class="step-item active" id="step-btn-1">
        <div class="step-number" id="step-num-1">1</div>
        <span class="step-label">Species</span>
      </button>

      <button onclick="goToStep(2)" class="step-item" id="step-btn-2">
        <div class="step-number" id="step-num-2">2</div>
        <span class="step-label">Class</span>
      </button>

      <button onclick="goToStep(3)" class="step-item" id="step-btn-3">
        <div class="step-number" id="step-num-3">3</div>
        <span class="step-label">Background</span>
      </button>

      <button onclick="goToStep(4)" class="step-item" id="step-btn-4">
        <div class="step-number" id="step-num-4">4</div>
        <span class="step-label">Stats & Level</span>
      </button>

      <button onclick="goToStep(5)" class="step-item" id="step-btn-5">
        <div class="step-number" id="step-num-5">5</div>
        <span class="step-label">Summary</span>
      </button>
    </div>

    <!-- STEP 1: SPECIES SELECTION -->
    <section id="step-section-1" class="step-panel">
      <div class="toolbar no-print">
        <input type="text" id="species-search" oninput="filterSpecies()" placeholder="🔍 Search through all 76 species by name or trait..." class="search-input">
        <div class="filter-tags" id="species-cat-tags">
          <button onclick="filterCategory('all')" class="tag-btn active" data-cat="all">All (76)</button>
          <button onclick="filterCategory('core')" class="tag-btn" data-cat="core">Core & Humanoid</button>
          <button onclick="filterCategory('fey')" class="tag-btn" data-cat="fey">Fey & Nature</button>
          <button onclick="filterCategory('monstrous')" class="tag-btn" data-cat="monstrous">Monstrous</button>
          <button onclick="filterCategory('planar')" class="tag-btn" data-cat="planar">Planar & Exotic</button>
          <button onclick="filterCategory('construct')" class="tag-btn" data-cat="construct">Constructs & Undead</button>
        </div>
      </div>
      <div class="cards-grid" id="species-grid"></div>
    </section>

    <!-- STEP 2: CLASS SELECTION -->
    <section id="step-section-2" class="step-panel hidden">
      <div class="cards-grid" id="class-grid"></div>
    </section>

    <!-- STEP 3: BACKGROUND SELECTION -->
    <section id="step-section-3" class="step-panel hidden">
      <div class="cards-grid" id="bg-grid"></div>
    </section>

    <!-- STEP 4: STATS & LEVEL INPUTS -->
    <section id="step-section-4" class="step-panel hidden">
      <div class="form-panel">
        <div class="form-section-title">Hero Identity</div>
        <div style="display:grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap:1rem; margin-bottom:1.5rem;">
          <div class="form-group">
            <label>Character Name</label>
            <input type="text" id="input-char-name" placeholder="Enter hero name..." oninput="updateCharName(this.value)">
          </div>
          <div class="form-group">
            <label>Player / Student Name</label>
            <input type="text" id="input-player-name" placeholder="Enter student name..." oninput="updatePlayerName(this.value)">
          </div>
          <div class="form-group">
            <label>Character Level (1–20)</label>
            <select id="input-level-select" onchange="updateLevel(this.value)"></select>
          </div>
        </div>

        <div class="form-section-title">Ability Scores & Modifiers</div>
        <p style="font-size:0.8rem; color:var(--text-muted); margin-bottom:1rem;">Enter base stats (1–20) and check the box if a species/class bonus modifier is applied.</p>

        <div class="stats-grid">
          <div class="stat-box">
            <label>STR</label>
            <input type="number" id="stat-str" value="10" min="1" max="30" onchange="updateStats()">
            <label class="mod-checkbox-label"><input type="checkbox" id="mod-str" onchange="updateStats()"> Mod (+2)</label>
          </div>
          <div class="stat-box">
            <label>DEX</label>
            <input type="number" id="stat-dex" value="10" min="1" max="30" onchange="updateStats()">
            <label class="mod-checkbox-label"><input type="checkbox" id="mod-dex" onchange="updateStats()"> Mod (+2)</label>
          </div>
          <div class="stat-box">
            <label>CON</label>
            <input type="number" id="stat-con" value="10" min="1" max="30" onchange="updateStats()">
            <label class="mod-checkbox-label"><input type="checkbox" id="mod-con" onchange="updateStats()"> Mod (+2)</label>
          </div>
          <div class="stat-box">
            <label>INT</label>
            <input type="number" id="stat-int" value="10" min="1" max="30" onchange="updateStats()">
            <label class="mod-checkbox-label"><input type="checkbox" id="mod-int" onchange="updateStats()"> Mod (+2)</label>
          </div>
          <div class="stat-box">
            <label>WIS</label>
            <input type="number" id="stat-wis" value="10" min="1" max="30" onchange="updateStats()">
            <label class="mod-checkbox-label"><input type="checkbox" id="mod-wis" onchange="updateStats()"> Mod (+2)</label>
          </div>
          <div class="stat-box">
            <label>CHA</label>
            <input type="number" id="stat-cha" value="10" min="1" max="30" onchange="updateStats()">
            <label class="mod-checkbox-label"><input type="checkbox" id="mod-cha" onchange="updateStats()"> Mod (+2)</label>
          </div>
        </div>

        <div class="form-section-title">Saving Throw Proficiencies</div>
        <div class="selection-toggle-grid">
          <label class="toggle-item"><input type="checkbox" id="save-str" onchange="updateToggles()"> Strength</label>
          <label class="toggle-item"><input type="checkbox" id="save-dex" onchange="updateToggles()"> Dexterity</label>
          <label class="toggle-item"><input type="checkbox" id="save-con" onchange="updateToggles()"> Constitution</label>
          <label class="toggle-item"><input type="checkbox" id="save-int" onchange="updateToggles()"> Intelligence</label>
          <label class="toggle-item"><input type="checkbox" id="save-wis" onchange="updateToggles()"> Wisdom</label>
          <label class="toggle-item"><input type="checkbox" id="save-cha" onchange="updateToggles()"> Charisma</label>
        </div>

        <div class="form-section-title">Skill Proficiencies</div>
        <div class="selection-toggle-grid" id="skills-toggle-container">
          <!-- Populated via JS -->
        </div>
      </div>
    </section>

    <!-- STEP 5: D&D CHARACTER SHEET SUMMARY -->
    <section id="step-section-5" class="step-panel hidden">
      <div class="sheet-wrapper">
        <div style="display:flex; justify-content:flex-end; margin-bottom:1rem;" class="no-print">
          <button onclick="window.print()" class="btn btn-primary">🖨️ Print Character Sheet</button>
        </div>

        <div class="cs-sheet" id="printable-card">
          <!-- HEADER FRAME -->
          <div class="cs-header">
            <div class="cs-name-box">
              <h1 id="cs-char-name">Unnamed Hero</h1>
              <label>Character Name</label>
            </div>
            <div class="cs-header-fields">
              <div class="cs-field">
                <div class="val" id="cs-hdr-class">Fighter</div>
                <label>Class & Level</label>
              </div>
              <div class="cs-field">
                <div class="val" id="cs-hdr-species">Human</div>
                <label>Species</label>
              </div>
              <div class="cs-field">
                <div class="val" id="cs-hdr-bg">Soldier</div>
                <label>Background</label>
              </div>
              <div class="cs-field">
                <div class="val" id="cs-hdr-player">Player Name</div>
                <label>Player</label>
              </div>
              <div class="cs-field">
                <div class="val" id="cs-hdr-prof">+2</div>
                <label>Proficiency Bonus</label>
              </div>
              <div class="cs-field">
                <div class="val">Medium</div>
                <label>Size</label>
              </div>
            </div>
          </div>

          <!-- MAIN 3-COLUMN GRID -->
          <div class="cs-main-grid">
            
            <!-- COLUMN 1: ABILITIES, SAVES, PASSIVES -->
            <div class="cs-col-1">
              <div class="cs-ability-stack" id="cs-ability-container">
                <!-- STR, DEX, CON, INT, WIS, CHA Cards populated via JS -->
              </div>

              <!-- SAVING THROWS -->
              <div class="cs-box">
                <div class="cs-box-title">Saving Throws</div>
                <div class="cs-list" id="cs-saves-container"></div>
              </div>

              <!-- PASSIVE SENSES -->
              <div class="cs-box">
                <div class="cs-box-title">Passive Senses</div>
                <div class="cs-passive-item">
                  <span>Passive Perception</span>
                  <span class="val" id="cs-passive-perception">10</span>
                </div>
                <div class="cs-passive-item">
                  <span>Passive Investigation</span>
                  <span class="val" id="cs-passive-investigation">10</span>
                </div>
                <div class="cs-passive-item">
                  <span>Passive Insight</span>
                  <span class="val" id="cs-passive-insight">10</span>
                </div>
              </div>
            </div>

            <!-- COLUMN 2: COMBAT & SKILLS -->
            <div class="cs-col-2">
              <div class="cs-combat-grid">
                <div class="cs-combat-tile">
                  <span class="val" id="cs-val-ac">10</span>
                  <span class="lbl">Armor Class</span>
                </div>
                <div class="cs-combat-tile">
                  <span class="val" id="cs-val-init">+0</span>
                  <span class="lbl">Initiative</span>
                </div>
                <div class="cs-combat-tile">
                  <span class="val">30 ft</span>
                  <span class="lbl">Speed</span>
                </div>
              </div>

              <div class="cs-hp-box">
                <div class="cs-hp-sub">
                  <span class="val" id="cs-val-hp">--</span>
                  <span class="lbl">Max Hit Points</span>
                </div>
                <div style="height:25px; width:1px; background:var(--border-card);"></div>
                <div class="cs-hp-sub">
                  <span class="val" id="cs-val-hitdie">1d8</span>
                  <span class="lbl">Total Hit Dice</span>
                </div>
              </div>

              <!-- SKILLS LIST -->
              <div class="cs-box" style="flex-grow:1;">
                <div class="cs-box-title">Skills</div>
                <div class="cs-list" id="cs-skills-container"></div>
              </div>
            </div>

            <!-- COLUMN 3: FEATURE CARDS -->
            <div class="cs-col-3">
              <div class="cs-feature-card">
                <img id="cs-img-species" class="cs-feature-img" src="" alt="Species">
                <div class="cs-feature-content">
                  <div class="cs-feature-title" id="cs-title-species">Species</div>
                  <div class="cs-feature-sub" id="cs-sub-species">Traits</div>
                  <div class="cs-feature-desc" id="cs-desc-species">Description</div>
                </div>
              </div>

              <div class="cs-feature-card">
                <img id="cs-img-class" class="cs-feature-img" src="" alt="Class">
                <div class="cs-feature-content">
                  <div class="cs-feature-title" id="cs-title-class">Class</div>
                  <div class="cs-feature-sub" id="cs-sub-class">Stats</div>
                  <div class="cs-feature-desc" id="cs-desc-class">Description</div>
                </div>
              </div>

              <div class="cs-feature-card">
                <img id="cs-img-bg" class="cs-feature-img" src="" alt="Background">
                <div class="cs-feature-content">
                  <div class="cs-feature-title" id="cs-title-bg">Background</div>
                  <div class="cs-feature-sub" id="cs-sub-bg">Skills</div>
                  <div class="cs-feature-desc" id="cs-desc-bg">Description</div>
                </div>
              </div>
            </div>

          </div>
        </div>
      </div>
    </section>

    <!-- NAVIGATION BAR -->
    <div class="nav-bar no-print">
      <button id="nav-prev-btn" onclick="nextStep(-1)" class="btn" disabled>← Back</button>
      <span class="nav-status" id="nav-status-text">Step 1 of 5: Select Species</span>
      <button id="nav-next-btn" onclick="nextStep(1)" class="btn btn-primary">Next: Class →</button>
    </div>
  </main>

  <!-- CONTENT EDITOR MODAL -->
  <div class="modal-overlay" id="editor-modal">
    <div class="modal-box">
      <div class="modal-header">
        <h3>Custom Content & Image Editor</h3>
        <button onclick="closeEditorModal()" class="modal-close">&times;</button>
      </div>
      <div class="modal-body">
        <p style="font-size:0.8rem; color:var(--text-muted)">Edit details or change image sources for cards. Images can be pasted as URLs or uploaded from local storage.</p>
        
        <div class="form-group">
          <label>1. Select Category</label>
          <select id="edit-cat-select" onchange="populateItemDropdown()">
            <option value="species">Species</option>
            <option value="classes">Classes</option>
            <option value="backgrounds">Backgrounds</option>
          </select>
        </div>

        <div class="form-group">
          <label>2. Select Item to Edit</label>
          <select id="edit-item-select" onchange="loadItemToEditor()"></select>
        </div>

        <div class="form-group">
          <label>Card Title / Name</label>
          <input type="text" id="edit-input-title">
        </div>

        <div class="form-group">
          <label>Sub-heading / Key Traits</label>
          <input type="text" id="edit-input-sub">
        </div>

        <div class="form-group">
          <label>Description</label>
          <textarea id="edit-input-desc" rows="3"></textarea>
        </div>

        <div class="form-group">
          <label>Option A: Image URL</label>
          <input type="text" id="edit-input-imgurl" placeholder="https://example.com/image.jpg">
        </div>

        <div class="form-group">
          <label>Option B: Upload Local File</label>
          <input type="file" id="edit-input-file" accept="image/*" onchange="handleFileSelect(event)">
        </div>
      </div>
      <div class="modal-footer">
        <button onclick="resetCategoryToDefaults()" class="btn btn-danger" style="margin-right:auto">Reset Category</button>
        <button onclick="closeEditorModal()" class="btn">Cancel</button>
        <button onclick="saveCardEdits()" class="btn btn-primary">Save Changes</button>
      </div>
    </div>
  </div>

  <!-- TOAST MESSAGE -->
  <div class="toast" id="toast-msg">Action successful!</div>

