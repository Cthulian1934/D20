    function getSvgPlaceholder(text) {
      const encoded = encodeURIComponent(text);
      return `data:image/svg+xml;utf8,<svg xmlns="http://www.w3.org/2000/svg" width="300" height="200" viewBox="0 0 300 200"><rect width="100%" height="100%" fill="%2312101a"/><path d="M150 40 L210 160 L90 160 Z" fill="none" stroke="%233a354c" stroke-width="3"/><circle cx="150" cy="100" r="30" fill="none" stroke="%23d4af37" stroke-width="2"/><text x="50%" y="85%" font-family="sans-serif" font-size="16" font-weight="bold" fill="%23d4af37" text-anchor="middle">${encoded}</text></svg>`;
    }

    window.onload = function() {
      populateLevelDropdown();
      populateSkillToggles();
      renderGrids();
      updateWizardUI();
    };

    function populateLevelDropdown() {
      const select = document.getElementById('input-level-select');
      select.innerHTML = '';
      for (let i = 1; i <= 20; i++) {
        const opt = document.createElement('option');
        opt.value = i;
        opt.innerText = `Level ${i}`;
        select.appendChild(opt);
      }
    }

    function populateSkillToggles() {
      const container = document.getElementById('skills-toggle-container');
      container.innerHTML = '';
      SKILLS_LIST.forEach(skill => {
        const label = document.createElement('label');
        label.className = 'toggle-item';
        label.innerHTML = `<input type="checkbox" id="skill-chk-${skill.name.replace(/\s+/g, '')}" onchange="updateToggles()"> ${skill.name} <span style="font-size:0.65rem; color:var(--text-muted)">(${skill.stat.toUpperCase()})</span>`;
        container.appendChild(label);
      });
    }

    function renderGrids() {
      renderSpeciesGrid();
      renderGenericGrid('classes', 'class-grid');
      renderGenericGrid('backgrounds', 'bg-grid');
    }

    function renderSpeciesGrid() {
      const container = document.getElementById('species-grid');
      const searchVal = (document.getElementById('species-search')?.value || '').toLowerCase();
      container.innerHTML = '';

      const filtered = appData.species.filter(item => {
        const matchesCat = selectedCatFilter === 'all' || item.cat === selectedCatFilter;
        const matchesSearch = item.title.toLowerCase().includes(searchVal) ||
                            item.sub.toLowerCase().includes(searchVal) ||
                            item.desc.toLowerCase().includes(searchVal);
        return matchesCat && matchesSearch;
      });

      if (filtered.length === 0) {
        container.innerHTML = `<div style="grid-column: 1/-1; text-align:center; padding:3rem; color:var(--text-muted)">No species found matching your filters.</div>`;
        return;
      }

      filtered.forEach(item => {
        const isSelected = selectedChar.species?.id === item.id;
        const card = document.createElement('div');
        card.className = `rpg-card ${isSelected ? 'selected' : ''}`;
        card.onclick = () => selectCard('species', item);

        const imgSrc = item.img || getSvgPlaceholder(item.title);

        card.innerHTML = `
          <div class="card-img-wrapper">
            <img class="card-img" src="${imgSrc}" alt="${item.title}" onerror="this.style.display='none'">
            ${isSelected ? '<div class="selected-check">✓</div>' : ''}
            <span class="badge-tag">${item.cat}</span>
          </div>
          <div class="card-body">
            <div class="card-title">${item.title}</div>
            <div class="card-subtitle">${item.sub}</div>
            <div class="card-desc">${item.desc}</div>
          </div>
          <div class="card-footer">
            <button class="card-select-btn">${isSelected ? '✓ Selected' : 'Choose ' + item.title}</button>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function renderGenericGrid(catKey, gridId) {
      const container = document.getElementById(gridId);
      container.innerHTML = '';

      appData[catKey].forEach(item => {
        const charKey = catKey === 'classes' ? 'class' : 'background';
        const isSelected = selectedChar[charKey]?.id === item.id;
        const card = document.createElement('div');
        card.className = `rpg-card ${isSelected ? 'selected' : ''}`;
        card.onclick = () => selectCard(catKey, item);

        const imgSrc = item.img || getSvgPlaceholder(item.title);

        card.innerHTML = `
          <div class="card-img-wrapper">
            <img class="card-img" src="${imgSrc}" alt="${item.title}" onerror="this.style.display='none'">
            ${isSelected ? '<div class="selected-check">✓</div>' : ''}
          </div>
          <div class="card-body">
            <div class="card-title">${item.title}</div>
            <div class="card-subtitle">${item.sub}</div>
            <div class="card-desc">${item.desc}</div>
          </div>
          <div class="card-footer">
            <button class="card-select-btn">${isSelected ? '✓ Selected' : 'Choose ' + item.title}</button>
          </div>
        `;
        container.appendChild(card);
      });
    }

    function selectCard(category, item) {
      if (category === 'species') selectedChar.species = item;
      if (category === 'classes') selectedChar.class = item;
      if (category === 'backgrounds') selectedChar.background = item;

      renderGrids();

      setTimeout(() => {
        if (currentStep < 5) {
          nextStep(1);
        }
      }, 200);
    }

    function filterSpecies() {
      renderSpeciesGrid();
    }

    function filterCategory(cat) {
      selectedCatFilter = cat;
      document.querySelectorAll('#species-cat-tags .tag-btn').forEach(btn => {
        if (btn.getAttribute('data-cat') === cat) {
          btn.classList.add('active');
        } else {
          btn.classList.remove('active');
        }
      });
      renderSpeciesGrid();
    }

    function updateCharName(val) {
      selectedChar.name = val;
    }

    function updatePlayerName(val) {
      selectedChar.player = val;
    }

    function updateLevel(val) {
      selectedChar.level = parseInt(val) || 1;
    }

    function updateStats() {
      ['str', 'dex', 'con', 'int', 'wis', 'cha'].forEach(stat => {
        const scoreVal = parseInt(document.getElementById(`stat-${stat}`).value) || 10;
        const modCheck = document.getElementById(`mod-${stat}`).checked;
        selectedChar.stats[stat] = scoreVal;
        selectedChar.mods[stat] = modCheck;
      });
    }

    function updateToggles() {
      ['str', 'dex', 'con', 'int', 'wis', 'cha'].forEach(stat => {
        selectedChar.saves[stat] = document.getElementById(`save-${stat}`).checked;
      });

      SKILLS_LIST.forEach(skill => {
        const id = `skill-chk-${skill.name.replace(/\s+/g, '')}`;
        selectedChar.skills[skill.name] = document.getElementById(id)?.checked || false;
      });
    }

    function getProficiencyBonus(lvl) {
      if (lvl <= 4) return 2;
      if (lvl <= 8) return 3;
      if (lvl <= 12) return 4;
      if (lvl <= 16) return 5;
      return 6;
    }

    function calcModNum(score, hasBonus = false) {
      const finalScore = score + (hasBonus ? 2 : 0);
      return Math.floor((finalScore - 10) / 2);
    }

    function formatMod(modNum) {
      return modNum >= 0 ? `+${modNum}` : `${modNum}`;
    }

    function nextStep(delta) {
      const target = currentStep + delta;

      if (delta > 0) {
        if (currentStep === 1 && !selectedChar.species) return showToast('Please select a Species first!');
        if (currentStep === 2 && !selectedChar.class) return showToast('Please select a Class first!');
        if (currentStep === 3 && !selectedChar.background) return showToast('Please select a Background first!');
      }

      if (target >= 1 && target <= 5) {
        currentStep = target;
        updateWizardUI();
      }
    }

    function goToStep(step) {
      if (step > 1 && !selectedChar.species) return showToast('Please select a Species first!');
      if (step > 2 && !selectedChar.class) return showToast('Please select a Class first!');
      if (step > 3 && !selectedChar.background) return showToast('Please select a Background first!');

      currentStep = step;
      updateWizardUI();
    }

    function updateWizardUI() {
      for (let i = 1; i <= 5; i++) {
        const panel = document.getElementById(`step-section-${i}`);
        const btn = document.getElementById(`step-btn-${i}`);
        
        if (i === currentStep) {
          panel.classList.remove('hidden');
          btn.className = 'step-item active';
        } else if (i < currentStep) {
          panel.classList.add('hidden');
          btn.className = 'step-item completed';
        } else {
          panel.classList.add('hidden');
          btn.className = 'step-item';
        }
      }

      const progressPercent = ((currentStep - 1) / 4) * 100;
      document.getElementById('progress-line').style.width = `${progressPercent}%`;

      const prevBtn = document.getElementById('nav-prev-btn');
      const nextBtn = document.getElementById('nav-next-btn');
      const statusText = document.getElementById('nav-status-text');

      prevBtn.disabled = currentStep === 1;

      if (currentStep === 1) {
        statusText.innerText = 'Step 1 of 5: Select Species';
        nextBtn.innerText = 'Next: Class →';
      } else if (currentStep === 2) {
        statusText.innerText = 'Step 2 of 5: Select Class';
        nextBtn.innerText = 'Next: Background →';
      } else if (currentStep === 3) {
        statusText.innerText = 'Step 3 of 5: Select Background';
        nextBtn.innerText = 'Next: Stats & Level →';
      } else if (currentStep === 4) {
        statusText.innerText = 'Step 4 of 5: Ability Scores & Level';
        nextBtn.innerText = 'View Character Summary →';
      } else if (currentStep === 5) {
        statusText.innerText = 'Step 5 of 5: Character Sheet Ready';
        nextBtn.innerText = 'Finish ✓';
        renderCharacterSheet();
      }

      window.scrollTo({ top: 0, behavior: 'smooth' });
    }

    // RENDER FULL D&D CHARACTER SHEET SUMMARY
    function renderCharacterSheet() {
      const sp = selectedChar.species || appData.species[0];
      const cl = selectedChar.class || appData.classes[0];
      const bg = selectedChar.background || appData.backgrounds[0];
      const lvl = selectedChar.level || 1;
      const prof = getProficiencyBonus(lvl);

      // Header Info
      document.getElementById('cs-char-name').innerText = selectedChar.name.trim() !== '' ? selectedChar.name : 'Unnamed Hero';
      document.getElementById('cs-hdr-class').innerText = `${cl.title} ${lvl}`;
      document.getElementById('cs-hdr-species').innerText = sp.title;
      document.getElementById('cs-hdr-bg').innerText = bg.title;
      document.getElementById('cs-hdr-player').innerText = selectedChar.player.trim() !== '' ? selectedChar.player : 'Player';
      document.getElementById('cs-hdr-prof').innerText = `+${prof}`;

      // Calculated Mods
      const mods = {};
      ['str', 'dex', 'con', 'int', 'wis', 'cha'].forEach(s => {
        const score = selectedChar.stats[s] + (selectedChar.mods[s] ? 2 : 0);
        mods[s] = Math.floor((score - 10) / 2);
      });

      // Ability Stack Render
      const abContainer = document.getElementById('cs-ability-container');
      abContainer.innerHTML = '';
      ['str', 'dex', 'con', 'int', 'wis', 'cha'].forEach(s => {
        const score = selectedChar.stats[s] + (selectedChar.mods[s] ? 2 : 0);
        const card = document.createElement('div');
        card.className = `cs-ability-card ${selectedChar.mods[s] ? 'modified' : ''}`;
        card.innerHTML = `
          <span class="cs-ability-label">${s.toUpperCase()}</span>
          <span class="cs-ability-mod">${formatMod(mods[s])}</span>
          <span class="cs-ability-score">${score}</span>
        `;
        abContainer.appendChild(card);
      });

      // Saving Throws Render
      const savesContainer = document.getElementById('cs-saves-container');
      savesContainer.innerHTML = '';
      ['str', 'dex', 'con', 'int', 'wis', 'cha'].forEach(s => {
        const isProf = selectedChar.saves[s];
        const totalMod = mods[s] + (isProf ? prof : 0);
        const item = document.createElement('div');
        item.className = 'cs-list-item';
        item.innerHTML = `
          <span class="cs-dot ${isProf ? 'active' : ''}"></span>
          <span class="cs-list-val">${formatMod(totalMod)}</span>
          <span class="cs-list-lbl">${s.toUpperCase()}</span>
        `;
        savesContainer.appendChild(item);
      });

      // Combat Stats Render
      document.getElementById('cs-val-ac').innerText = 10 + mods.dex;
      document.getElementById('cs-val-init').innerText = formatMod(mods.dex);

      const hitDieVal = cl.hitDie || 8;
      const avgHd = Math.floor(hitDieVal / 2) + 1;
      const totalHp = (hitDieVal + mods.con) + ((lvl - 1) * (avgHd + mods.con));

      document.getElementById('cs-val-hp').innerText = Math.max(1, totalHp);
      document.getElementById('cs-val-hitdie').innerText = `${lvl}d${hitDieVal}`;

      // Skills List Render
      const skillsContainer = document.getElementById('cs-skills-container');
      skillsContainer.innerHTML = '';
      SKILLS_LIST.forEach(skill => {
        const isProf = selectedChar.skills[skill.name] || false;
        const totalMod = mods[skill.stat] + (isProf ? prof : 0);
        const item = document.createElement('div');
        item.className = 'cs-list-item';
        item.innerHTML = `
          <span class="cs-dot ${isProf ? 'active' : ''}"></span>
          <span class="cs-list-val">${formatMod(totalMod)}</span>
          <span class="cs-list-lbl">${skill.name} <span style="font-size:0.6rem; color:var(--text-muted)">(${skill.stat.toUpperCase()})</span></span>
        `;
        skillsContainer.appendChild(item);
      });

      // Passive Senses
      const percProf = selectedChar.skills['Perception'] || false;
      const invProf = selectedChar.skills['Investigation'] || false;
      const insProf = selectedChar.skills['Insight'] || false;

      document.getElementById('cs-passive-perception').innerText = 10 + mods.wis + (percProf ? prof : 0);
      document.getElementById('cs-passive-investigation').innerText = 10 + mods.int + (invProf ? prof : 0);
      document.getElementById('cs-passive-insight').innerText = 10 + mods.wis + (insProf ? prof : 0);

      // Feature Cards (Species, Class, BG)
      document.getElementById('cs-img-species').src = sp.img || getSvgPlaceholder(sp.title);
      document.getElementById('cs-title-species').innerText = sp.title;
      document.getElementById('cs-sub-species').innerText = sp.sub;
      document.getElementById('cs-desc-species').innerText = sp.desc;

      document.getElementById('cs-img-class').src = cl.img || getSvgPlaceholder(cl.title);
      document.getElementById('cs-title-class').innerText = cl.title;
      document.getElementById('cs-sub-class').innerText = cl.sub;
      document.getElementById('cs-desc-class').innerText = cl.desc;

      document.getElementById('cs-img-bg').src = bg.img || getSvgPlaceholder(bg.title);
      document.getElementById('cs-title-bg').innerText = bg.title;
      document.getElementById('cs-sub-bg').innerText = bg.sub;
      document.getElementById('cs-desc-bg').innerText = bg.desc;
    }

    function resetAllSelections() {
      if (confirm('Reset your character selections and start over?')) {
        selectedChar = {
          name: '', player: '', level: 1, species: null, class: null, background: null,
          stats: { str: 10, dex: 10, con: 10, int: 10, wis: 10, cha: 10 },
          mods: { str: false, dex: false, con: false, int: false, wis: false, cha: false },
          saves: { str: false, dex: false, con: false, int: false, wis: false, cha: false },
          skills: {}
        };
        document.getElementById('input-char-name').value = '';
        document.getElementById('input-player-name').value = '';
        currentStep = 1;
        renderGrids();
        updateWizardUI();
        showToast('Selections reset.');
      }
    }

    // TEACHER CONTENT EDITOR MODAL
    function openEditorModal() {
      document.getElementById('editor-modal').classList.add('active');
      populateItemDropdown();
    }

    function closeEditorModal() {
      document.getElementById('editor-modal').classList.remove('active');
    }

    function populateItemDropdown() {
      const catKey = document.getElementById('edit-cat-select').value;
      const itemSelect = document.getElementById('edit-item-select');
      itemSelect.innerHTML = '';

      appData[catKey].forEach(item => {
        const opt = document.createElement('option');
        opt.value = item.id;
        opt.innerText = item.title;
        itemSelect.appendChild(opt);
      });

      loadItemToEditor();
    }

    function loadItemToEditor() {
      const catKey = document.getElementById('edit-cat-select').value;
      const itemId = document.getElementById('edit-item-select').value;
      const item = appData[catKey].find(i => i.id === itemId);

      if (!item) return;

      document.getElementById('edit-input-title').value = item.title;
      document.getElementById('edit-input-sub').value = item.sub;
      document.getElementById('edit-input-desc').value = item.desc;
      document.getElementById('edit-input-imgurl').value = item.img || '';
    }

    function handleFileSelect(evt) {
      const file = evt.target.files[0];
      if (file) {
        const reader = new FileReader();
        reader.onload = function(e) {
          document.getElementById('edit-input-imgurl').value = e.target.result;
        };
        reader.readAsDataURL(file);
      }
    }

    function saveCardEdits() {
      const catKey = document.getElementById('edit-cat-select').value;
      const itemId = document.getElementById('edit-item-select').value;
      const itemIdx = appData[catKey].findIndex(i => i.id === itemId);

      if (itemIdx !== -1) {
        appData[catKey][itemIdx].title = document.getElementById('edit-input-title').value;
        appData[catKey][itemIdx].sub = document.getElementById('edit-input-sub').value;
        appData[catKey][itemIdx].desc = document.getElementById('edit-input-desc').value;
        appData[catKey][itemIdx].img = document.getElementById('edit-input-imgurl').value;

        localStorage.setItem('rpg_character_app_data', JSON.stringify(appData));
        renderGrids();
        closeEditorModal();
        showToast('Card updated successfully!');
      }
    }

    function resetCategoryToDefaults() {
      const catKey = document.getElementById('edit-cat-select').value;
      if (confirm(`Reset all ${catKey} cards back to original defaults?`)) {
        if (catKey === 'species') appData.species = SPECIES_DATA;
        if (catKey === 'classes') appData.classes = CLASS_DATA;
        if (catKey === 'backgrounds') appData.backgrounds = BACKGROUND_DATA;

        localStorage.setItem('rpg_character_app_data', JSON.stringify(appData));
        renderGrids();
        populateItemDropdown();
        showToast(`Reset ${catKey} to default content.`);
      }
    }

    function showToast(msg) {
      const toast = document.getElementById('toast-msg');
      toast.innerText = msg;
      toast.classList.add('show');
      setTimeout(() => {
        toast.classList.remove('show');
      }, 3000);
    }
  </script>
</body>
</html>

